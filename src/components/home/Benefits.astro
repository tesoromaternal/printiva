---
import { Headphones, Palette, ShieldCheck, Truck } from "lucide-react";

const benefits = [
  { icon: Palette, title: "Diseños 100% personalizados", text: "Tú decides, nosotros lo hacemos." },
  { icon: ShieldCheck, title: "Calidad garantizada", text: "Usamos los mejores materiales." },
  { icon: Truck, title: "Envíos rápidos", text: "A toda España." },
  { icon: Headphones, title: "Atención cercana", text: "Te ayudamos en todo el proceso." },
];
---

<section class="bg-cloud">
  <ul class="container-page grid gap-6 py-8 sm:grid-cols-2 lg:grid-cols-4 lg:divide-x lg:divide-line">
    {
      benefits.map(({ icon: Icon, title, text }) => (
        <li class="flex items-center gap-4 lg:justify-center lg:px-4">
          <Icon className="size-9 shrink-0 stroke-[1.5]" aria-hidden="true" />
          <div>
            <p class="font-extrabold">{title}</p>
            <p class="text-sm text-ink-soft">{text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
