---
import { ArrowRight } from "lucide-react";

interface Props {
  title: string;
  subtitle?: string;
  link?: { href: string; label: string };
  as?: "h1" | "h2";
}

const { title, subtitle, link, as: Tag = "h2" } = Astro.props;
---

<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
  <div>
    <Tag class:list={["font-extrabold", Tag === "h1" ? "text-3xl sm:text-4xl" : "text-2xl"]}>{title}</Tag>
    <span class="mt-2 block h-1 w-10 rounded-full bg-brand"></span>
    {subtitle && <p class="mt-3 max-w-2xl text-ink-soft">{subtitle}</p>}
  </div>
  {
    link && (
      <a href={link.href} class="inline-flex items-center gap-1.5 text-sm font-bold hover:text-brand">
        {link.label} <ArrowRight className="size-4" />
      </a>
    )
  }
</div>
