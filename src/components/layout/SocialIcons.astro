---

<ul class:list={["flex items-center gap-4", className]}>
  {
    networks.map(({ label, href, path }) => (
      <li>
        <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} class="block transition hover:text-brand">
          <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
            <path d={path} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
