---
interface Props {
  tone?: "dark" | "light";
  class?: string;
}

const { tone = "dark", class: className } = Astro.props;
const ink = tone === "dark" ? "text-ink" : "text-white";
const petals = [
  { rotate: -64, fill: "#22B8E6" },
  { rotate: -30, fill: "#FFC93C" },
  { rotate: 4, fill: "#EC1E79" },
  { rotate: 38, fill: "#8B5CF6" },
];
---

<a href="/" class:list={["group inline-flex items-center gap-2.5", className]} aria-label="Printiva, ir al inicio">
  <svg viewBox="0 0 64 64" class="h-11 w-11 shrink-0 transition-transform duration-300 group-hover:rotate-6 sm:h-14 sm:w-14" aria-hidden="true">
    {
      petals.map(({ rotate, fill }) => (
        <path
          d="M0 0 C-11 -18 -8 -40 0 -48 C8 -40 11 -18 0 0 Z"
          fill={tone === "light" ? "#FFFFFF" : fill}
          opacity={tone === "light" ? 0.9 : 1}
          transform={`translate(28 56) rotate(${rotate})`}
        />
      ))
    }
    <circle cx="54" cy="16" r="5" fill={tone === "light" ? "#FFFFFF" : "#FF8A3D"}></circle>
  </svg>
  <span class="flex flex-col leading-none">
    <span class:list={["font-script text-[2rem] sm:text-[2.6rem]", ink]}>Printiva</span>
    <span class:list={["mt-0.5 text-[0.7rem] font-bold tracking-wide sm:text-sm", ink]}>
      Personaliza · Crea · Regala
    </span>
  </span>
</a>
