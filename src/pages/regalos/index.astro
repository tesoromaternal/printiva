---
import SectionHeading from "../../components/SectionHeading.astro";
import { getOccasions } from "../../features/catalog/repository";
import BaseLayout from "../../layouts/BaseLayout.astro";

const occasions = await getOccasions();
---

<BaseLayout title="Regalos personalizados" description="Regalos personalizados para mamá, papá, parejas, cumpleaños, bodas, comuniones, bautizos, Navidad y mucho más.">
  <div class="container-page py-10">
    <SectionHeading
      as="h1"
      title="Regalos personalizados 🎁"
      subtitle="El mismo producto, mil motivos. Elige la ocasión y te enseñamos las ideas que más triunfan."
    />
    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {
        occasions.map((occasion) => (
          <li>
            <a
              href={`/regalos/${occasion.slug}`}
              class="group flex h-full flex-col rounded-3xl p-6 transition hover:-translate-y-1 hover:shadow-lg"
              style={`background:${occasion.tint}`}
            >
              <span class="text-4xl transition-transform group-hover:scale-110" aria-hidden="true">{occasion.emoji}</span>
              <span class="mt-4 text-lg font-extrabold">{occasion.name}</span>
              <span class="mt-1 text-sm text-ink-soft">{occasion.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
