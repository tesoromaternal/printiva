---
import { resolveCta } from "../../features/blog/cta";
import { getPublishedPost } from "../../features/blog/repository";
import { htmlToText, readingMinutes } from "../../features/blog/sanitize";
import BaseLayout from "../../layouts/BaseLayout.astro";

const post = await getPublishedPost(Astro.params.slug ?? "");
if (!post) return Astro.rewrite("/404");

const description = post.excerpt || htmlToText(post.contentHtml).slice(0, 160);
const cta = resolveCta(post);
const date = post.publishedAt ? new Intl.DateTimeFormat("es-ES", { dateStyle: "long" }).format(new Date(post.publishedAt)) : "";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt,
  image: post.coverUrl ?? undefined,
  publisher: { "@type": "Organization", name: "Printiva" },
};
---

<BaseLayout title={post.title} description={description} image={post.coverUrl} type="article">
  <article class="container-page max-w-3xl py-10">
    <a href="/blog" class="text-sm font-bold text-ink-soft hover:text-brand">← Blog</a>
    <h1 class="mt-4 text-4xl leading-tight font-black sm:text-5xl">{post.title}</h1>
    <p class="mt-3 text-sm font-bold tracking-wide text-ink-soft uppercase">{date} · {readingMinutes(post.contentHtml)} min de lectura</p>

    {post.coverUrl && <img src={post.coverUrl} alt={post.coverAlt} class="mt-8 aspect-[16/9] w-full rounded-3xl object-cover" />}

    <!-- contentHtml se saneó en el servidor al guardarse (features/blog/sanitize.ts). -->
    <div class="prose prose-lg mt-10 max-w-none prose-headings:font-extrabold prose-strong:font-extrabold prose-a:text-brand prose-img:rounded-2xl" set:html={post.contentHtml} />

    {
      cta && (
        <aside class="mt-14 rounded-3xl bg-brand-soft p-8 text-center">
          <p class="font-marker text-2xl">{cta.title}</p>
          <p class="mt-1 text-ink-soft">{cta.text}</p>
          <a href={cta.url} class="btn-brand mt-5" {...(cta.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
            {cta.label}
          </a>
        </aside>
      )
    }
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
</BaseLayout>
