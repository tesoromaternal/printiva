---
import SectionHeading from "../../components/SectionHeading.astro";
import CategoryCircles from "../../features/catalog/components/CategoryCircles.astro";
import ProductGrid from "../../features/catalog/components/ProductGrid.astro";
import { getCategories, getProductsByCategory } from "../../features/catalog/repository";
import BaseLayout from "../../layouts/BaseLayout.astro";

const categories = await getCategories();
const category = categories.find((c) => c.slug === Astro.params.categoria);
if (!category) return Astro.rewrite("/404");

const products = await getProductsByCategory(category.slug);
---

<BaseLayout title={category.name} description={category.description}>
  <div class="container-page py-10">
    <nav class="mb-4 text-sm text-ink-soft" aria-label="Migas de pan">
      <a href="/" class="hover:text-brand">Inicio</a> / <a href="/tienda" class="hover:text-brand">Tienda</a> /
      <span class="font-semibold text-ink">{category.name}</span>
    </nav>
    <SectionHeading as="h1" title={category.name} subtitle={category.description} />
    <div class="mb-10"><CategoryCircles categories={categories} activeSlug={category.slug} /></div>
    <ProductGrid products={products} />
  </div>
</BaseLayout>
