---
import type { Product } from "../types";
import ProductCard from "./ProductCard";

interface Props {
  products: Product[];
  emptyMessage?: string;
}

const { products, emptyMessage = "Pronto añadiremos productos aquí. ¿Tienes una idea? Escríbenos." } = Astro.props;
---

{
  products.length === 0 ? (
    <p class="rounded-2xl bg-cloud p-8 text-center font-semibold text-ink-soft">{emptyMessage}</p>
  ) : (
    <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
      {products.map((product) => <ProductCard client:visible product={product} />)}
    </div>
  )
}
