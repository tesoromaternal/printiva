# ─────────────────────────────────────────────────────────────
# Printiva · variables de entorno
# Copiar a .env (local) y cargar las mismas en Vercel → Settings → Environment Variables.
# NUNCA commitear .env con valores reales.
# ─────────────────────────────────────────────────────────────

# ── Base de datos (Turso / libSQL) ───────────────────────────
# Vacío en local = SQLite en ./local.db (mismo motor que Turso).
# En Vercel es OBLIGATORIO: el filesystem es de solo lectura.
#   turso db create printiva
#   turso db show printiva --url
#   turso db tokens create printiva
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Pagos (SumUp) ────────────────────────────────────────────
# SumUp → Perfil → Developers → API keys (clave secreta).
# Merchant code: código de comercio (formato MXXXXXXX), en tu perfil de SumUp.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# ── Emails de pedidos (Resend) ───────────────────────────────
# El remitente debe ser de un dominio verificado en Resend.
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL_FROM=Printiva <pedidos@printiva.es>
ORDER_NOTIFY_EMAIL_TO=

# ── Panel de admin (/admin) ──────────────────────────────────
# Sin estas dos, /admin responde 503 "Admin no configurado".
# El hash se genera con:  pnpm admin:hash   (pide la contraseña sin mostrarla)
# NUNCA pongas la contraseña en texto plano: solo el hash scrypt:...
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# ── Fotos (Vercel Blob, store PÚBLICO) ───────────────────────
# Vercel → Storage → Create → Blob → acceso "Public" → conectar al proyecto.
# Luego: vercel env pull  (o copiar el token del store).
# Sin token, EN LOCAL las fotos se guardan en public/uploads (solo para probar).
BLOB_READ_WRITE_TOKEN=

# ── URLs del sitio ───────────────────────────────────────────
# Origen de confianza para los callbacks de pago (solo https, sin ruta ni barra final).
# Obligatorio en producción salvo que Vercel ponga VERCEL_PROJECT_PRODUCTION_URL.
# En local puede quedar vacío: se acepta localhost.
SITE_URL=
# URL pública para canonical / Open Graph (puede ser la misma que SITE_URL).
PUBLIC_SITE_URL=
